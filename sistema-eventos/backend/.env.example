# Copie este arquivo para backend/.env e preencha os valores.

# Obrigatória, com pelo menos 32 caracteres: sem ela, a API não sobe.
# Cada instalação gera a sua com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=mysql+pymysql://root:SUA_SENHA@localhost:3306/sistema_eventos

# Opcionais (sem elas, vale o valor mais seguro):
# Liga o modo debug, com recarga automática. Só no seu computador.
# API_DEBUG=1
# Abre a API para a rede, para o celular acessar pelo IP do computador.
# Não funciona junto com API_DEBUG=1.
# API_HOST=0.0.0.0
# Sites liberados no navegador, separados por vírgula (hospedagem).
# CORS_ORIGENS=https://endereco-do-site
